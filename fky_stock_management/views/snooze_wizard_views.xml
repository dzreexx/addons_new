<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="view_fky_stock_snooze_wizard_form" model="ir.ui.view">
        <field name="name">fky.stock.snooze.wizard.form</field>
        <field name="model">fky.stock.snooze.wizard</field>
        <field name="arch" type="xml">
            <form string="Snooze Product">
                <div class="alert alert-info" role="alert">
                    This product will be hidden from the Stock Alert Dashboard
                    for the number of days below.
                </div>
                <group>
                    <field name="product_id" readonly="1"/>
                    <field name="snooze_days"/>
                </group>
                <footer>
                    <button name="action_snooze" string="Snooze" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>