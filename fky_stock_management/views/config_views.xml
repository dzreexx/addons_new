<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Default singleton config record created on install -->
    <record id="fky_stock_config_default" model="fky.stock.config">
        <field name="name">Stock Alert &amp; Analysis Settings</field>
        <field name="low_stock_percent">80.0</field>
        <field name="urgent_stock_percent">20.0</field>
        <field name="average_months">12</field>
        <field name="stock_coverage_months">3</field>
        <field name="best_seller_months">3</field>
    </record>

    <!-- Form View -->
    <record id="view_fky_stock_config_form" model="ir.ui.view">
        <field name="name">fky.stock.config.form</field>
        <field name="model">fky.stock.config</field>
        <field name="arch" type="xml">
            <form string="Stock Alert &amp; Analysis Settings">
                <group>
                    <group string="Alert Thresholds">
                        <field name="low_stock_percent" options="{'digits': 0}"/>
                        <field name="urgent_stock_percent" options="{'digits': 0}"/>
                        <field name="best_seller_months"/>
                    </group>
                    <group string="Excluded Products">
                        <field name="exclude_product_ids"
                               widget="many2many_tags"
                               options="{'no_create': True, 'no_open': True}"
                               help="These products are never generated by the Generate Rules wizard. This is the single place to manage the list."/>
                    </group>
                    <group string="On Hand Stock Locations">
                        <field name="on_hand_location_ids"
                               widget="many2many_tags"
                               options="{'no_create': True, 'no_open': True}"
                               help="Only these locations count as current on-hand stock. Leave empty to use all internal locations."/>
                    </group>
                </group>
            </form>
        </field>
    </record>

    <!-- Action (opens the singleton config record as a wizard dialog) -->
    <record id="action_fky_stock_config" model="ir.actions.server">
        <field name="name">Stock Alert &amp; Analysis Settings</field>
        <field name="model_id" ref="model_fky_stock_config"/>
        <field name="state">code</field>
        <field name="code">action = env['fky.stock.config'].open_settings()</field>
    </record>

</odoo>