<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="fky_stock_analysis_final_report_tree" model="ir.ui.view">
            <field name="name">fky.stock.analysis.final.report.tree</field>
            <field name="model">fky.stock.analysis.final.report</field>
            <field name="arch" type="xml">
                <tree string="Final Reports" create="false">
                    <field name="name" optional="show"/>
                    <field name="source_mark" string="Mark" optional="show"/>
                    <field name="company_id" optional="show"/>
                    <field name="create_date" string="Generated At" optional="show"/>
                    <field name="user_id" string="Generated By" optional="show"/>
                    <field name="source_report_id" optional="show"/>
                    <field name="line_count" string="Jumlah Baris" optional="show"/>
                </tree>
            </field>
        </record>

        <record id="fky_stock_analysis_final_report_search" model="ir.ui.view">
            <field name="name">fky.stock.analysis.final.report.search</field>
            <field name="model">fky.stock.analysis.final.report</field>
            <field name="arch" type="xml">
                <search string="Search Final Reports">
                    <field name="name" string="Title"/>
                    <field name="company_id" string="Company"/>
                    <field name="user_id" string="Generated By"/>
                    <field name="source_report_id" string="Source Report"/>
                    <group expand="0" string="Group By">
                        <filter string="Source Report" name="group_source"
                                 context="{'group_by': 'source_report_id'}"/>
                        <filter string="Company" name="group_company"
                                 context="{'group_by': 'company_id'}"/>
                        <filter string="Generated By" name="group_user"
                                 context="{'group_by': 'user_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="fky_stock_analysis_final_report_form" model="ir.ui.view">
            <field name="name">fky.stock.analysis.final.report.form</field>
            <field name="model">fky.stock.analysis.final.report</field>
            <field name="arch" type="xml">
                <form string="Final Report">
                    <header>
                        <button name="action_refresh_from_source"
                                string="Refresh from Source"
                                type="object"
                                class="btn-secondary"
                                icon="fa-refresh"
                                attrs="{'invisible': [('source_report_id', '=', False)]}"/>
                        <button name="action_view_lines"
                                string="Search Lines"
                                type="object"
                                class="btn-secondary"
                                icon="fa-search"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group string="Final">
                                <field name="company_id" readonly="1"/>
                                <field name="source_mark" string="Same-Source Mark" readonly="1"/>
                                <field name="user_id" readonly="1"/>
                                <field name="create_date" string="Generated At" readonly="1"/>
                            </group>
                            <group string="Source">
                                <field name="source_report_id" readonly="1"/>
                                <field name="source_preview_id" readonly="1"/>
                            </group>
                        </group>
                        <group string="Final Lines" colspan="2">
                            <field name="line_ids" nolabel="1">
                                <tree create="false" delete="false" editable="bottom">
                                    <field name="internal_category_id" string="Int. Category" optional="show"/>
                                    <field name="product_brand_id" string="Brand" optional="show"/>
                                    <field name="default_code" string="Code" optional="show"/>
                                    <field name="product_name" string="Product Name" optional="show"/>
                                    <field name="on_hand_qty" string="Stok Saat Ini" optional="show" digits="[16, 0]"/>
                                    <field name="incoming_qty" string="Incoming (PO)" optional="show" digits="[16, 0]"/>
                                    <field name="sales_order_qty" string="Backorder" optional="show" digits="[16, 0]"/>
                                    <field name="average_monthly_sales" string="Average Month" optional="show" digits="[16, 0]"/>
                                    <field name="coverage_months" string="Ket. Bulan" optional="show" options="{'digits': 0}"/>
                                    <field name="target_stock_qty" string="Target Stok" optional="show" digits="[16, 0]"/>
                                    <field name="recommended_purchase_qty" string="Planning Pembelian" optional="show" digits="[16, 0]"/>
                                    <field name="isi_perdus" string="Isi Per Dus" optional="show" digits="[16, 0]"/>
                                    <field name="moq_qty" string="MoQ" optional="show" digits="[16, 0]"/>
                                    <field name="final_qty" string="Final Quantity" optional="show" digits="[16, 0]"/>
                                    <field name="months_of_stock" string="Ket. Stok" optional="hide" digits="[16, 0]"/>
                                    <field name="future_months_of_stock" string="Ket. + PO" optional="hide" digits="[16, 0]"/>
                                    <field name="vendor_id" string="Vendor" optional="hide"/>
                                    <field name="has_components" invisible="1"/>
                                    <button name="action_view_components" string="Components" type="object" icon="fa-sitemap" attrs="{'invisible': [('has_components', '=', False)]}"/>
                                </tree>
                            </field>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_fky_stock_final_reports" model="ir.actions.act_window">
            <field name="name">Final Reports</field>
            <field name="res_model">fky.stock.analysis.final.report</field>
            <field name="view_mode">tree,form</field>
        </record>

        <record id="fky_stock_analysis_final_line_tree" model="ir.ui.view">
            <field name="name">fky.stock.analysis.final.line.tree</field>
            <field name="model">fky.stock.analysis.final.line</field>
            <field name="arch" type="xml">
                <tree string="Final Lines" create="false" delete="false" editable="bottom">
                    <field name="final_id" optional="show"/>
                    <field name="internal_category_id" string="Int. Category" optional="show"/>
                    <field name="product_brand_id" string="Brand" optional="show"/>
                    <field name="default_code" string="Code" optional="show"/>
                    <field name="product_name" string="Product Name" optional="show"/>
                    <field name="on_hand_qty" string="Stok Saat Ini" optional="show" digits="[16, 0]"/>
                    <field name="incoming_qty" string="Incoming (PO)" optional="show" digits="[16, 0]"/>
                    <field name="sales_order_qty" string="Backorder" optional="show" digits="[16, 0]"/>
                    <field name="average_monthly_sales" string="Average Month" optional="show" digits="[16, 0]"/>
                    <field name="coverage_months" string="Ket. Bulan" optional="show" options="{'digits': 0}"/>
                    <field name="target_stock_qty" string="Target Stok" optional="show" digits="[16, 0]"/>
                    <field name="recommended_purchase_qty" string="Planning Pembelian" optional="show" digits="[16, 0]"/>
                    <field name="isi_perdus" string="Isi Per Dus" optional="show" digits="[16, 0]"/>
                    <field name="moq_qty" string="MoQ" optional="show" digits="[16, 0]"/>
                    <field name="final_qty" string="Final Quantity" optional="show" digits="[16, 0]"/>
                    <field name="months_of_stock" string="Ket. Stok" optional="hide" digits="[16, 0]"/>
                    <field name="future_months_of_stock" string="Ket. + PO" optional="hide" digits="[16, 0]"/>
                    <field name="vendor_id" string="Vendor" optional="hide"/>
                    <field name="has_components" invisible="1"/>
                    <button name="action_view_components" string="Components" type="object" icon="fa-sitemap" attrs="{'invisible': [('has_components', '=', False)]}"/>
                </tree>
            </field>
        </record>

        <record id="fky_stock_analysis_final_line_search" model="ir.ui.view">
            <field name="name">fky.stock.analysis.final.line.search</field>
            <field name="model">fky.stock.analysis.final.line</field>
            <field name="arch" type="xml">
                <search string="Search Final Lines">
                    <field name="product_id" string="Product"/>
                    <field name="internal_category_id" string="Internal Category"/>
                    <field name="product_brand_id" string="Brand"/>
                    <field name="vendor_id" string="Vendor"/>
                    <field name="final_id" string="Final Report"/>
                    <filter string="Has Components"
                            name="has_components"
                            domain="[('has_components', '=', True)]"/>
                    <filter string="No Components"
                            name="no_components"
                            domain="[('has_components', '=', False)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Internal Category" name="group_cat"
                                 context="{'group_by': 'internal_category_id'}"/>
                        <filter string="Brand" name="group_brand"
                                 context="{'group_by': 'product_brand_id'}"/>
                        <filter string="Vendor" name="group_vendor"
                                 context="{'group_by': 'vendor_id'}"/>
                        <filter string="Final Report" name="group_final"
                                 context="{'group_by': 'final_id'}"/>
                    </group>
                </search>
            </field>
        </record>

    </data>
</odoo>
