<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fky_return_condition_fix_form" model="ir.ui.view">
        <field name="name">fky.return.condition.fix.form</field>
        <field name="model">fky.return.condition.fix</field>
        <field name="arch" type="xml">
            <form string="Fix Sales Return Condition">
                <group>
                    <group string="Old Database (read only)">
                        <field name="old_db_name"/>
                        <field name="old_db_host"/>
                        <field name="old_db_port"/>
                        <field name="old_db_user"/>
                        <field name="old_db_password" password="True"/>
                    </group>
                    <group string="Target">
                        <field name="condition_name"/>
                        <field name="mode"/>
                    </group>
                </group>
                <group>
                    <group>
                        <field name="duplicates_merged"/>
                        <field name="lines_moved"/>
                        <field name="would_update"/>
                    </group>
                    <group>
                        <field name="already_filled"/>
                        <field name="conflicts"/>
                        <field name="missing"/>
                    </group>
                </group>
                <field name="log" nolabel="1" colspan="2"/>
                <footer>
                    <button name="action_run" string="Run" type="object" class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_fky_return_condition_fix" model="ir.actions.act_window">
        <field name="name">Fix Sales Return Condition</field>
        <field name="res_model">fky.return.condition.fix</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_fky_return_condition_fix"
        name="Fix Sales Return Condition"
        action="action_fky_return_condition_fix"
        parent="sale.menu_sale_config"
        groups="base.group_system"
        sequence="99"/>
</odoo>
